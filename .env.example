# Application
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/freshcart

# Authentication
# Replace this with a long random value in the real .env file.
JWT_SECRET=replace_with_a_long_random_secret

# Frontend URLs
CLIENT_URL=http://localhost:3000
# Optional comma-separated list when more than one frontend is allowed.
CLIENT_URLS=http://localhost:3000

# Transactional email through Brevo HTTPS API
EMAIL_ENABLED=false
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=FreshCart

# Galli Maps
GALLI_ACCESS_TOKEN=your_galli_maps_access_token

# Gemini grocery assistant
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# eSewa
ESEWA_ENVIRONMENT=test
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# Optional fallback only. Browser payments automatically return to the frontend origin that started checkout.
ESEWA_RETURN_URL=http://localhost:3000/user/payment/esewa

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=freshcart

# Application
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/freshcart

# Authentication
# Replace this with a long random value in the real .env file.
JWT_SECRET=replace_with_a_long_random_secret

# Frontend URLs
CLIENT_URL=http://localhost:3000

# Optional comma-separated list used when more than one frontend
# domain must be allowed by CORS.
CLIENT_URLS=http://localhost:3000

# Email notifications
# Keep false when email delivery is not being tested.
EMAIL_ENABLED=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=FreshCart <your_email@gmail.com>

# Leave EMAIL_HOST empty to use Gmail service configuration.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false

# Galli Maps
GALLI_ACCESS_TOKEN=your_galli_maps_access_token

# Gemini grocery assistant
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# eSewa
ESEWA_ENVIRONMENT=test
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_RETURN_URL=https://your-public-frontend-domain.com/user/payment/esewa